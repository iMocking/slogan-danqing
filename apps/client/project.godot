; Engine configuration file.
; 仙途（slogan-danqing）客户端工程配置
; 结构与规范见 docs/05-Godot技术方案.md 与 docs/09-客户端架构设计说明书

config_version=5

[application]

config/name="slogan-danqing"
run/main_scene="res://src/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameConfig="*res://src/autoload/game_config.gd"
InputSetup="*res://src/autoload/input_setup.gd"
GameServer="*res://src/autoload/game_server.gd"
Toast="*res://src/autoload/toast.gd"
UiManager="*res://src/autoload/ui_manager.gd"
SceneRouter="*res://src/autoload/scene_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
